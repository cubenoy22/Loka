# Retro68 host configuration
# Copy this file to .env-retro68 and adjust paths for this machine.
# VS Code Retro68 tasks and scripts/retro68-cmake.sh load it automatically.

# Retro68 build output containing toolchain/.
RETRO68_BUILD_DIR="$HOME/Retro68-build"

# Optional host-tool directory used for hformat, hcopy, hmount, and humount.
#RETRO68_TOOLCHAIN_BIN="$HOME/Retro68-build/toolchain/bin"

# Set this when Ninja is not visible to VS Code. Typical values are
# /opt/homebrew/bin/ninja on Apple Silicon macOS and /usr/bin/ninja on Linux.
#CMAKE_MAKE_PROGRAM="/path/to/ninja"
